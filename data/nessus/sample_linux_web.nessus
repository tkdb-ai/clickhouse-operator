      <ReportItem port="443" svc_name="https" protocol="tcp" severity="2" pluginID="65821" pluginName="SSL RC4 Cipher Suites Supported (Bar Mitzvah)" pluginFamily="General">
        <synopsis>The remote service supports the use of the RC4 cipher.</synopsis>
